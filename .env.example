# Copy this file to ".env" and fill it in. Never share or upload your real .env.

# ---- Platform manager login (created the first time the app starts) --------
# Sign in at /admin with MANAGER_EMAIL and this password (at least 10 characters).
# Better: run  flask --app app hash-password  and paste the ADMIN_PASSWORD_HASH=... line instead.
# Or create managers any time with:  flask --app app create-manager you@example.com
# Leave empty on your own computer to use the local demo login admin@crochets.local / admin.
MANAGER_EMAIL=
ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=

# New sellers who sign up at /sell wait for your approval. Set to true to let them go live at once.
AUTO_APPROVE_SELLERS=false

# ---- Reporting sales -----------------------------------------------------------
# Sellers must mark each order Delivered (sold) or Cancelled within ORDER_RESOLVE_DAYS
# (custom work: CUSTOM_RESOLVE_DAYS, or the buyer's needed-by date + 7). They're warned
# WARN_DAYS before; shops with orders still open SUSPEND_GRACE_DAYS after the due date
# are suspended automatically. Run  flask --app app enforce-sales  from a daily cron job
# too if your site gets little traffic (the check also runs by itself every 30 minutes of activity).
ORDER_RESOLVE_DAYS=14
CUSTOM_RESOLVE_DAYS=30
WARN_DAYS=3
SUSPEND_GRACE_DAYS=3

# ---- Public website -----------------------------------------------------------
# Your real address (used in the sitemap, share links and status flyers).
SITE_URL=                       # e.g. https://crochetsmarket.com
# Parent company: Crochets Market is its subsidiary. Shown in the legal pages, footer and reports.
PARENT_COMPANY=LukeTrust LLC
LEGAL_UPDATED=16 November 2026

# ---- Google AdSense (leave empty until AdSense approves your site) ----------
# Ads only load for visitors who tap "Accept all" in the cookie banner.
ADSENSE_CLIENT=                 # ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_SLOT=                   # a responsive display ad-unit id from AdSense → Ads → By ad unit

# ---- Your shop (shown to customers) ----------------------------------------
SHOP_NAME=Crochets Market
SHOP_WHATSAPP=231775684913      # country code + number, digits only
SHOP_COUNTRY_CODE=231           # turns local numbers like 0770… into WhatsApp links
SHOP_EMAIL=luketrustcrochetsmarket@gmail.com
SHOP_LOCATION=Monrovia, Liberia
SHOP_INSTAGRAM=                 # e.g. https://instagram.com/crochetsmarket
SHOP_FACEBOOK=
SHOP_TIKTOK=
SHOP_LOW_STOCK_AT=2

# ---- Money ---------------------------------------------------------------------
# Prices are entered in US$ and always shown with the L$ equivalent.
# Starting rate (L$ per US$1). You can change it any time in the dashboard → Settings & help.
USD_TO_LRD=171

# ---- New-order e-mails (optional) ------------------------------------------
# Each order is e-mailed to the seller's login e-mail; SELLER_EMAIL also gets a copy of every order.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 and an "App password".
SELLER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Server -----------------------------------------------------------------
# Set to "production" on your real website (requires HTTPS, enables secure cookies).
APP_ENV=development
# SECRET_KEY=                   # created automatically in instance/ if left empty
# DATABASE_PATH=                # default: instance/augs.sqlite3
# UPLOAD_FOLDER=                # default: instance/uploads
